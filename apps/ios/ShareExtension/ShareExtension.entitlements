<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as the main app (ADR-020 / ADR-021), so the extension's
	     staging drop folder lives in the container the app drains. Must match
	     AppGroup.identifier and the app's Pergamon.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.pergamon</string>
	</array>
</dict>
</plist>
